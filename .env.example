# ============================================
# SafeChat — API Gateway Environment Config
# ============================================
APP_NAME=SafeChat API Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (Relational Transactional Core)
DATABASE_URL=postgresql+asyncpg://safety_user:safety_password@localhost:5432/safety_platform
# For docker-compose use: postgresql+asyncpg://safety_user:safety_password@postgres:5432/safety_platform

# Redis (High-Speed In-Memory Cache & Rate Limit)
REDIS_URL=redis://localhost:6379/0
# For docker-compose use: redis://redis:6379/0
RATE_LIMIT_MESSAGES_PER_MINUTE=20

# MongoDB (Chat History & Continuous Learning Analytics)
MONGODB_URL=mongodb://localhost:27017
# For docker-compose use: mongodb://mongodb:27017
MONGODB_DB=safechat
CHAT_COLLECTION=chat_messages

# ML Service URL
ML_SERVICE_URL=http://localhost:8001
# For docker-compose use: http://ml-service:8000

# Security & Authentication
JWT_SECRET_KEY=supersecretkey_change_in_production_998877665544332211
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]


